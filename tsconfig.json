{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": "./src",
		"outDir": "./lib",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src"],
	"exclude": ["node_modules", "lib", "**/__tests__/*"]
}